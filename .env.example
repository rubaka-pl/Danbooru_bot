# Обязательно
BOT_TOKEN=123456:ABC...

# Канал/группа для автопоста
GROUP_ID=@Obitel_Dionisa
AUTOPOST=on                 # off — выключить автопост
AUTOPOST_INTERVAL=60        # секунды (для режима polling)
QUIET_HOURS=23:30-06:00     # off — без тихих часов
TZ_NAME=Europe/Warsaw       # часовой пояс для тихих часов и рассылки
ALBUM_EVERY=8               # примерно каждый N-й автопост — альбом 5–10 картинок (0 — выкл.)
ADAPTIVE_SHARE=0.4          # доля автопостов по тегам, которые лайкают в канале
DIGEST_HOUR=12              # рассылка по подпискам — каждый день после этого часа
ADMIN_IDS=                  # кому доступна /stats (id через запятую), пусто — всем

# Danbooru (необязательно)
DANBOORU_LOGIN=
DANBOORU_API_KEY=
DANBOORU_TAG_LIMIT=2        # 6 для Gold, 12 для Platinum

# Только для Vercel
WEBHOOK_SECRET=придумай-длинную-строку
CRON_SECRET=ещё-одна-длинная-строка
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
