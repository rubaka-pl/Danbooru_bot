# Обязательно
BOT_TOKEN=123456:ABC...

# Канал/группа для автопоста
GROUP_ID=@Obitel_Dionisa
AUTOPOST=on                 # off — выключить автопост
AUTOPOST_INTERVAL=60        # секунды (для режима polling)
ADULT_GROUP_ID=@obitel_dionisa_18  # второй канал/группа — только 18+ (пусто — выкл.)
ADULT_AUTOPOST=on           # off — выключить автопост 18+
ADULT_AUTOPOST_INTERVAL=60  # секунды (для режима polling)
ADULT_AUTOPOST_SCHEDULE=fresh:3,mix:1,packs:1  # фазы 18+ по кругу (часы): свежак дольше
ADULT_RECENT_YEARS=2        # 18+ «вразнобой» и «паки» — только за последние N лет (0 — за все)
AUTOPOST_SCHEDULE=fresh:2,mix:1,packs:1  # фазы по кругу (часы): свежак, вразнобой, паки; off — всегда вразнобой
FRESH_DAYS=30               # свежак: арты не старше N дней
FRESH_MIN_SCORE=10          # …и с рейтингом выше
PACK_EVERY=3                # в фазе «паки» примерно каждый N-й пост — альбом
QUIET_HOURS=23:30-06:00     # off — без тихих часов
TZ_NAME=Europe/Warsaw       # часовой пояс для тихих часов и рассылки
ALBUM_EVERY=8               # примерно каждый N-й автопост — альбом 5–10 картинок (0 — выкл.)
BATTLE_EVERY=25             # примерно каждый N-й автопост — «Битва артов» с опросом (0 — выкл.)
USER_HOURLY_LIMIT=200       # картинок в час на пользователя (0 — без лимита)
ADAPTIVE_SHARE=0.4          # доля автопостов по тегам, которые лайкают в канале
DIGEST_HOUR=12              # рассылка по подпискам — каждый день после этого часа
ADMIN_IDS=                  # кому доступна /stats (id через запятую), пусто — всем

# Danbooru (необязательно)
DANBOORU_LOGIN=
DANBOORU_API_KEY=
DANBOORU_TAG_LIMIT=2        # 6 для Gold, 12 для Platinum

# Только для Vercel
WEBHOOK_SECRET=придумай-длинную-строку
CRON_SECRET=ещё-одна-длинная-строка
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# «Топ недели» в канале
RECAP=on
RECAP_WEEKDAY=0             # 0 — воскресенье
RECAP_HOUR=20
