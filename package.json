{
  "name": "danbooru-telegram-bot",
  "version": "2.0.0",
  "description": "Telegram-бот, который ищет арты на Danbooru и постит их в канал",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "webhook:set": "node scripts/setWebhook.js",
    "webhook:delete": "node scripts/setWebhook.js --delete",
    "test:coverage": "node --test --experimental-test-coverage",
    "check:danbooru": "node scripts/checkDanbooru.js"
  },
  "license": "ISC",
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "telegraf": "^4.16.3"
  }
}
